# Plantilla de variables de entorno. Copiar a .env y completar los valores.
# NO poner credenciales reales en este archivo (sí se versiona).

SECRET_KEY=cambiar-por-una-clave-secreta
DEBUG=True

# Base de datos
DB_ENGINE=django.db.backends.mysql
DB_NAME=formularios
DB_USER=lms_user
DB_PASSWORD=
DB_HOST=mysql
DB_PORT=3306
DB_CHARSET=utf8mb4

# Email - Capacitaciones Generales (GoDaddy - Default)
EMAIL_HOST=mail.cloudregencyapps.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=notificacionappgh@formacion.cloudregencyapps.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notificacionappgh@formacion.cloudregencyapps.com

# Email - Examenes Medicos (360 CloudRegency)
EMAIL_MEDICAL_HOST=360.cloudregencyapps.com
EMAIL_MEDICAL_PORT=465
EMAIL_MEDICAL_USE_SSL=True
EMAIL_MEDICAL_USE_TLS=False
EMAIL_MEDICAL_HOST_USER=notificacionexamenes@360.cloudregencyapps.com
EMAIL_MEDICAL_HOST_PASSWORD=
EMAIL_MEDICAL_FROM_EMAIL=notificacionexamenes@360.cloudregencyapps.com

# Cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# MySQL (contenedor db)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=formularios
MYSQL_USER=lms_user
MYSQL_PASSWORD=
